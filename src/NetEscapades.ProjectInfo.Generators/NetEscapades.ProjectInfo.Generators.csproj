<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>NetEscapades.ProjectInfo.Generators</PackageId>
    <AssemblyName>$(PackageId)</AssemblyName>
    <RootNamespace>NetEscapades.ProjectInfo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <Description>A source generator for exposing information about your project at compile time</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <!-- Analyzer release tracking files are not used in this project -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" PrivateAssets="all" />
    <PackageReference Include="Polyfill" Version="11.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\NetEscapades.ProjectInfo.Generators.md" Pack="true" PackagePath="\README.md" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="NetEscapades.ProjectInfo.Generators.props" Pack="true" PackagePath="buildTransitive" Visible="true" />
    <None Include="NetEscapades.ProjectInfo.Generators.targets" Pack="true" PackagePath="buildTransitive" Visible="true" />
  </ItemGroup>
</Project>


