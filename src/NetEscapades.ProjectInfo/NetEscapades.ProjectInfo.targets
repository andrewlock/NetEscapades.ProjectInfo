<Project>
  <!--
    Passes the <ProjectInfoString> and <ProjectInfoUtf8> items to the generator in a single compiler-visible property,
    ProjectInfoItems. Nothing is written to disk. The format is a comma-separated list of "<S|U>|<name>|<value>"
    entries, where the name and value are URI-escaped (so they can never contain ',' '|' ';' '#' or newlines, which are
    significant to the generated .editorconfig file or to the format). The generator reverses the escaping.

    Back-quotes delimit the escaped text so that other quote characters are supported. A value that itself contains a
    back-quote is not evaluated by MSBuild; the generator detects this and reports NEPI005.
  -->
  <Target Name="NetEscapadesProjectInfo_SetItemsProperty" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
          Condition="'@(ProjectInfoString)' != '' or '@(ProjectInfoUtf8)' != ''">
    <ItemGroup Condition="'@(ProjectInfoString)' != ''">
      <_NetEscapadesProjectInfoEntry Include="S|$([System.Uri]::EscapeDataString(`%(ProjectInfoString.Identity)`))|$([System.Uri]::EscapeDataString(`%(ProjectInfoString.Value)`))" />
    </ItemGroup>
    <ItemGroup Condition="'@(ProjectInfoUtf8)' != ''">
      <_NetEscapadesProjectInfoEntry Include="U|$([System.Uri]::EscapeDataString(`%(ProjectInfoUtf8.Identity)`))|$([System.Uri]::EscapeDataString(`%(ProjectInfoUtf8.Value)`))" />
    </ItemGroup>
    <PropertyGroup>
      <ProjectInfoItems>@(_NetEscapadesProjectInfoEntry, ',')</ProjectInfoItems>
    </PropertyGroup>
    <ItemGroup>
      <_NetEscapadesProjectInfoEntry Remove="@(_NetEscapadesProjectInfoEntry)" />
    </ItemGroup>
  </Target>
</Project>
